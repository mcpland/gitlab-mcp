{
  "name": "gitlab-mcp",
  "version": "1.6.1",
  "description": "A MCP server for GitLab",
  "type": "module",
  "bin": {
    "gitlab-mcp": "dist/index.js",
    "gitlab-mcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcpland/gitlab-mcp.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "docs:generate": "tsx scripts/generate-tool-index.ts",
    "docs:check": "tsx scripts/generate-tool-index.ts --check",
    "test": "vitest run",
    "test:live": "tsx scripts/live-gitlab-smoke.ts",
    "test:watch": "vitest",
    "lint-staged": "lint-staged",
    "commit": "git-cz",
    "inspector": "pnpm exec @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fetch-cookie": "^3.2.0",
    "graphql": "^16.12.0",
    "open": "^11.0.0",
    "picomatch": "^4.0.5",
    "pino": "^10.3.1",
    "pkce-challenge": "^6.0.0",
    "tough-cookie": "^6.0.0",
    "undici": "^7.28.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/inspector": "^0.20.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/picomatch": "^4.0.2",
    "commitizen": "^4.3.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk>@hono/node-server": "1.19.13",
      "@modelcontextprotocol/sdk>ajv": "8.18.0",
      "@modelcontextprotocol/sdk>express-rate-limit": "8.2.2",
      "@modelcontextprotocol/sdk>hono": "4.12.25",
      "ajv>fast-uri": "3.1.2",
      "body-parser>qs": "6.15.2",
      "express-rate-limit>ip-address": "10.1.1",
      "express>qs": "6.15.2",
      "router>path-to-regexp": "8.4.0"
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "keywords": [
    "gitlab",
    "mcp",
    "ai",
    "agent",
    "tool",
    "automation"
  ],
  "author": "unadlib",
  "license": "MIT"
}
