NODE_ENV=development
LOG_LEVEL=info

MCP_SERVER_NAME=gitlab-mcp
# Optional override. By default, server version is read from package.json at startup.
# MCP_SERVER_VERSION=1.1.0
# Public HTTP issuer/base URL. Required by MCP OAuth and wildcard HTTP binds.
MCP_SERVER_URL=
# Optional independent bearer credential for /mcp and legacy SSE endpoints (minimum 32 characters).
MCP_HTTP_AUTH_TOKEN=
# Comma-separated Host header hostnames and browser origins allowed by the HTTP server.
# A wildcard bind (0.0.0.0/::) requires MCP_SERVER_URL or MCP_ALLOWED_HOSTS.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Base API URL(s). Supports comma-separated multi-instance URLs.
# Each URL will be normalized to /api/v4 automatically.
GITLAB_API_URL=https://gitlab.com/api/v4
# Additional canonical hosts or API URLs allowed in X-GitLab-API-URL.
GITLAB_ALLOWED_HOSTS=
# Upper bound for distinct configured GitLab API origins.
GITLAB_POOL_MAX_SIZE=100

# For stdio/local mode. In REMOTE_AUTHORIZATION mode this can stay empty.
GITLAB_PERSONAL_ACCESS_TOKEN=
# Optional CI job-token fallback when no personal access token is configured.
GITLAB_JOB_TOKEN=

# Optional built-in OAuth (PKCE)
GITLAB_USE_OAUTH=false
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_GITLAB_URL=
GITLAB_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
GITLAB_OAUTH_SCOPES=api
# Optional OAuth user allowlist by GitLab group full_path; parent paths include subgroups.
GITLAB_OAUTH_ALLOWED_GROUPS=
GITLAB_OAUTH_GROUP_CACHE_TTL_SECONDS=60
GITLAB_OAUTH_GROUP_CACHE_MAX_ENTRIES=1000
GITLAB_OAUTH_TOKEN_PATH=~/.gitlab-mcp-oauth-token.json
GITLAB_OAUTH_AUTO_OPEN_BROWSER=true

# Optional MCP OAuth authorization server for remote HTTP clients.
# This mode is mutually exclusive with REMOTE_AUTHORIZATION=true.
# Create one GitLab OAuth application with callback `${MCP_SERVER_URL}/callback`
# (the MCP_SERVER_URL path prefix is preserved) and api/read_api scope.
GITLAB_MCP_OAUTH=false
GITLAB_OAUTH_APP_ID=
# Optional for confidential GitLab OAuth applications.
GITLAB_OAUTH_APP_SECRET=
# Shared AEAD master key for virtual DCR/state/code values. Generate with: openssl rand -base64 32
GITLAB_MCP_OAUTH_STATE_SECRET=
# Multi-pod rotation is two-phase: old=current/new=previous, then new=current/old=previous.
# Keep the old key here for a full client TTL after phase two completes.
GITLAB_MCP_OAUTH_STATE_SECRET_PREVIOUS=
GITLAB_MCP_OAUTH_CLIENT_TTL_SECONDS=2592000
GITLAB_MCP_OAUTH_CODE_TTL_SECONDS=600

# Tool/runtime policy
# readonly = reads only; modify = read/write/admin without delete; full = all capabilities.
GITLAB_PERMISSION_MODE=full
# Deprecated legacy switch. true always overrides GITLAB_PERMISSION_MODE and forces readonly.
GITLAB_READ_ONLY_MODE=false
GITLAB_ALLOWED_PROJECT_IDS=
GITLAB_ALLOWED_TOOLS=
# Optional domain presets: core,projects,repository,merge-requests,issues,pipelines,
# ci-catalog,ci-variables,dependency-proxy,wiki,milestones,releases,labels,groups,
# work-items,webhooks,identity,graphql,all
GITLAB_TOOLSETS=core
# Expose legacy duplicate tool names for older clients.
GITLAB_ENABLE_COMPATIBILITY_ALIASES=false
# Sensitive CI/CD variable tools require both this opt-in and the ci-variables/all toolset.
GITLAB_ENABLE_CI_VARIABLE_TOOLS=false
# Even when tools are enabled, list/get values require this and include_value=true per call.
GITLAB_ALLOW_CI_VARIABLE_VALUES=false
# Dependency Proxy tools require both this opt-in and the dependency-proxy/all toolset.
GITLAB_ENABLE_DEPENDENCY_PROXY_TOOLS=false
# Disable capability classes globally: read,write,delete,admin,graphql.
GITLAB_DISABLED_CAPABILITIES=
GITLAB_DENIED_TOOLS_REGEX=
# Deprecated compatibility setting; raw GraphQL stays disabled with a project allowlist.
GITLAB_ALLOW_GRAPHQL_WITH_PROJECT_SCOPE=false

# Output tuning
# Use compact-json for agent-facing deployments to avoid indentation token overhead.
GITLAB_RESPONSE_MODE=json
GITLAB_MAX_RESPONSE_BYTES=200000
GITLAB_MAX_LOCAL_FILE_BYTES=250000000
# Comma-separated roots for stdio local uploads and artifact writes. Defaults to process cwd.
GITLAB_LOCAL_FILE_ROOTS=
# Set a random 32+ character shared secret for stable download URLs across replicas; random per process when omitted.
GITLAB_DOWNLOAD_TOKEN_SECRET=
GITLAB_DOWNLOAD_TOKEN_TTL_SECONDS=300
GITLAB_HTTP_TIMEOUT_MS=20000
# Generic GET retries only; mutations are never retried.
GITLAB_HTTP_MAX_RETRIES=2
GITLAB_HTTP_RETRY_BASE_MS=250
GITLAB_HTTP_RETRY_MAX_DELAY_MS=10000
GITLAB_AUTH_VALIDATION_TIMEOUT_MS=5000
# Valid and invalid remote-token checks are cached briefly; maximum is 300 seconds.
GITLAB_AUTH_VALIDATION_TTL_SECONDS=30
GITLAB_ERROR_DETAIL_MODE=

# Optional auth/runtime enhancements
GITLAB_AUTH_COOKIE_PATH=
GITLAB_COOKIE_WARMUP_PATH=/user
GITLAB_TOKEN_SCRIPT=
GITLAB_TOKEN_SCRIPT_TIMEOUT_MS=10000
GITLAB_TOKEN_CACHE_SECONDS=300
GITLAB_TOKEN_FILE=
GITLAB_ALLOW_INSECURE_TOKEN_FILE=false

# Cloudflare/proxy compatibility
GITLAB_CLOUDFLARE_BYPASS=false
GITLAB_USER_AGENT=
GITLAB_ACCEPT_LANGUAGE=en-US,en;q=0.9

# TLS safety guard (must acknowledge if disabled)
NODE_TLS_REJECT_UNAUTHORIZED=
GITLAB_ALLOW_INSECURE_TLS=false
GITLAB_CA_CERT_PATH=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Feature toggles
USE_GITLAB_WIKI=true
USE_MILESTONE=true
USE_PIPELINE=true
USE_RELEASE=true

# Remote auth/session controls (for Streamable HTTP).
# REMOTE_AUTHORIZATION=true is mutually exclusive with GITLAB_MCP_OAUTH=true.
REMOTE_AUTHORIZATION=false
ENABLE_DYNAMIC_API_URL=false
OAUTH_STATELESS_MODE=false
SESSION_TIMEOUT_SECONDS=3600
MAX_SESSIONS=1000
MAX_REQUESTS_PER_MINUTE=300
MAX_REQUESTS_PER_MINUTE_PER_IP=300
# Trust exactly one reverse-proxy hop for req.ip / X-Forwarded-For. Leave false for direct exposure.
MCP_TRUST_PROXY=false

# HTTP server
HTTP_HOST=127.0.0.1
HTTP_PORT=3333
HTTP_JSON_ONLY=false
SSE=false
# Prometheus endpoint (disabled by default). Use a dedicated 32+ character token for remote scrapes.
MCP_METRICS_ENABLED=false
MCP_METRICS_AUTH_TOKEN=
